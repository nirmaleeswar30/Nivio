# Supabase Configuration for Watch Party Feature
# Replace these values with your actual Supabase project credentials.
# You can find these in your Supabase Dashboard under Settings > API.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Deep Link & Share Preview Configuration (e.g. Vercel deployment on custom domain)
SHARE_REDIRECT_URL=https://your-domain/watch

# Sponsor Configuration
# Your GitHub Sponsors URL (or any other sponsorship link)
GITHUB_SPONSOR_URL=https://github.com/sponsors/yourusername

DESKTOP_GOOGLE_CLIENT_ID=YOUR_NEW_DESKTOP_CLIENT_ID_HERE
DESKTOP_GOOGLE_CLIENT_SECRET=YOUR_DESKTOP_CLIENT_SECRET_HERE

# Simkl sync (movies, TV & anime). Register an AUTH V2 "Mobile, desktop &
# browser apps" app at https://simkl.com/settings/developer/ — it uses PKCE,
# so there is NO client secret. Set the redirect URL to nivio://auth/simkl.
SIMKL_CLIENT_ID=YOUR_SIMKL_CLIENT_ID_HERE
SIMKL_REDIRECT_URL=nivio://auth/simkl
