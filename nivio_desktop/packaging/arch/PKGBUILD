# Maintainer: Nivio Desktop Maintainers <support@nivio.app>
pkgname=nivio-desktop
pkgver=1.0.0
pkgrel=1
pkgdesc="Nivio Desktop for Linux"
arch=('x86_64')
url="https://nivio.app"
license=('custom')
depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'mpv'
  'glib2'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'xdg-utils'
)
makedepends=(
  'flutter'
  'cmake'
  'ninja'
  'pkgconf'
  'clang'
)
options=('!strip')
source=()
sha256sums=()

build() {
  cd "$startdir/../.."

  if [[ "${SKIP_FLUTTER_BUILD:-0}" != "1" ]]; then
    flutter build linux --release
  fi
}

package() {
  local root="$startdir/../.."
  local bundle="$root/build/linux/x64/release/bundle"

  if [[ ! -x "$bundle/nivio_desktop" ]]; then
    echo "Release bundle not found at $bundle" >&2
    echo "Run: flutter build linux --release" >&2
    return 1
  fi

  install -d "$pkgdir/opt/nivio-desktop"
  cp -R --no-preserve=ownership "$bundle/." "$pkgdir/opt/nivio-desktop/"

  install -Dm755 "$root/packaging/linux/nivio-desktop" \
    "$pkgdir/usr/bin/nivio-desktop"
  install -Dm644 "$root/packaging/linux/com.nivio.desktop.desktop" \
    "$pkgdir/usr/share/applications/com.nivio.desktop.desktop"
  cp -R --no-preserve=ownership "$root/linux/runner/resources/icons/hicolor" \
    "$pkgdir/usr/share/icons/"
}
